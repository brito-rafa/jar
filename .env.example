# Run make local-db-init to generate a local .env with a random authentication token.
JAR_DB_TOKEN=replace_with_64_hex_characters
DB_PORT=9494
# Existing database directory on the host; jar.db is stored here.
# Make creates this directory if it does not exist.
DB_DATA_DIR=./data

# Required for indexing: one or more existing directories, separated by ; (no default).
# Example: DOCS=/absolute/path/to/documents;/another/path/with spaces
DOCS=

# Embedding vector dimensions; must match the embedding model output.
DIMENSIONS=768

# Local browser chat (separate from the DuckDB port).
CHAT_PORT=8080
OPEN_BROWSER=true

# Optional exact public origin when using Tailscale Serve or another reverse proxy.
CHAT_PUBLIC_URL=

# Set 0.0.0.0 and true to allow unauthenticated chat on all IPv4 interfaces.
CHAT_HOST=127.0.0.1
CHAT_ALLOW_ANY_HOST=false

# Optional remote services (host:port); leave empty to skip their connectivity checks.
# Examples: remote-embedding=100.74.54.18:8081
#           remote-chat=100.74.54.18:8080
#           remote-db=100.74.54.18:9494
remote-embedding=
remote-chat=
remote-db=
remote-db-token=replace_with_remote_server_token

# Optional API model IDs; empty discovers the sole model advertised by each server.
remote-chat-model=
remote-embedding-model=

# Enable only for a remote DuckDB server intentionally serving plain HTTP.
remote-db-disable-ssl=false

# Indexing defaults: one embedding worker, eight inputs per request.
EMBEDDING_WORKERS=1
EMBEDDING_BATCH_SIZE=8
# Completed embedding batches queued while inserts run (independent of workers).
EMBEDDING_BUFFER_BATCHES=16
