# Copy to .env and replace the service endpoints and token.
# Make reads .env; direct binaries read exported environment variables and CLI flags.
DB_URL=quack:duckdb.example.com:9494
DB_TOKEN=replace_with_your_duckdb_server_token
# Enable only for a DuckDB server intentionally serving plain HTTP.
DB_DISABLE_SSL=false
CHAT_URL=https://chat.example.com
EMBEDDING_URL=https://embedding.example.com

# API model IDs; empty discovers the sole model advertised by each endpoint.
CHAT_MODEL=
EMBEDDING_API_MODEL=
# Canonical identity stored in the index, separate from the embedding API alias.
# Preserve these values when reusing an existing index.
EMBEDDING_MODEL=bartowski/granite-embedding-278m-multilingual-GGUF:Q8_0
DIMENSIONS=768

# Required for indexing only; existing directories separated by semicolons.
DOCS=
FORCE_INDEX=false
DOCUMENT_WORKERS=20
EMBEDDING_WORKERS=1
EMBEDDING_BATCH_SIZE=8
EMBEDDING_BUFFER_BATCHES=16
INSERT_BATCH_SIZE=128

CHAT_PORT=18080
OPEN_BROWSER=true
CHAT_HOST=127.0.0.1
CHAT_ALLOW_ANY_HOST=false
# Optional exact public origin for Tailscale Serve or another reverse proxy.
CHAT_PUBLIC_URL=
