# Copy to .env and replace the service endpoints and token.
# Make reads .env; direct binaries read exported environment variables and CLI flags.
DB_URL=quack:duckdb.example.com:9494
DB_TOKEN=replace_with_your_duckdb_server_token
# Enable only for a DuckDB server intentionally serving plain HTTP.
DB_DISABLE_SSL=false
CHAT_URL=https://chat.example.com
EMBEDDING_URL=https://embedding.example.com

# API model IDs; empty discovers the sole model advertised by each endpoint.
CHAT_API_MODEL=
EMBEDDING_API_MODEL=
# Canonical identity stored in the index, separate from the embedding API alias.
# Preserve these values when reusing an existing index.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B-GGUF:Q4_K_M
DIMENSIONS=4096

# Required for indexing; existing directories separated by semicolons.
# For generated Kubernetes Jobs these are absolute paths on the assigned node;
# each path is mounted read-only at the same path in the container.
DOCS=
FORCE_INDEX=false
DOCUMENT_WORKERS=20
EMBEDDING_WORKERS=1
EMBEDDING_BATCH_SIZE=8
EMBEDDING_BUFFER_BATCHES=16
INSERT_BATCH_SIZE=128

CHAT_PORT=18080
OPEN_BROWSER=true
CHAT_HOST=127.0.0.1
CHAT_ALLOW_ANY_HOST=false
# Optional exact public origin for Tailscale Serve or another reverse proxy.
# Generated Kubernetes chat defaults to http://jarchat when this is empty.
# Set the exact origin instead when accessing its full tailnet hostname.
CHAT_PUBLIC_URL=

# Read-only MCP tools for agents (make mcp; Kubernetes Deployment jar-mcp).
# The jar-mcp Service is cluster-internal: http://jar-mcp.<NAMESPACE>.svc.cluster.local/mcp
MCP_HOST=127.0.0.1
MCP_PORT=18090

# Kubernetes manifest generation: make generate-manifests (does not deploy).
# Images default to the same registry namespace/tag used by make push.
REGISTRY=ghcr.io/brito-rafa
IMAGE_TAG=latest
PLATFORM=linux/amd64
NAMESPACE=jar
# Optional full image references; empty uses REGISTRY/jar-index|jar-chat|jar-mcp:IMAGE_TAG.
K8S_INDEX_IMAGE=
K8S_CHAT_IMAGE=
K8S_MCP_IMAGE=
# Optional node name for the index Job; DOCS must exist on its assigned node.
INDEX_NODE_NAME=
# Optional existing registry pull Secret in NAMESPACE.
IMAGE_PULL_SECRET=
